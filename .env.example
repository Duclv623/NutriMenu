# Copy to .env; put your real key ONLY in .env. Never send it in chat.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_GROUNDING_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_TIMEOUT=45
# Sustained generation pacing; up to 3 immediate calls for one chat.
GEMINI_REQUEST_INTERVAL=6.1
GEMINI_BURST_REQUESTS=3
# Optional alternative backend provider (always real API).
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini
GROUNDING_MODEL=gpt-4.1
EMBEDDING_MODEL=text-embedding-3-small
# The application has no offline answer mode.
ANSWER_MODE=gemini
APP_ENV=development
STORAGE_DIR=storage
SOURCE_MANIFEST=config/sources.json
TOP_K=5
CHUNK_TOKENS=420
CHUNK_OVERLAP=60
OPENAI_TIMEOUT=45
OPENAI_MAX_RETRIES=1
RATE_LIMIT_PER_MINUTE=20
HISTORY_RETENTION_DAYS=7
# Required in production. Get values/RS256 public key from TV1, not a guessed secret.
JWT_PUBLIC_KEY_PATH=
JWT_ISSUER=
JWT_AUDIENCE=
# Proposed TV2 read-only lookup endpoint; leave blank until contracts are agreed.
FOOD_API_BASE_URL=
